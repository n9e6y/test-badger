# Sites come from .env:
#   local:  APP_SITE=http://localhost        SHOP_SITE=http://shop.localhost
#   server: APP_SITE=app.<ip>.sslip.io       SHOP_SITE=shop.<ip>.sslip.io   (automatic HTTPS)

{$APP_SITE} {
	encode zstd gzip

	handle /api/* {
		# flush_interval -1: never buffer, so SSE (/api/runs/*/events) streams live.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Technical documentation (D30): static Claude Design export from technical-doc/
	# (gitignored; copied to the server separately), mounted read-only at /srv/doc.
	# /doc/ = documentation, /doc/deck = slide deck. The trailing slash keeps relative asset paths working.
	redir /doc /doc/ 308
	handle_path /doc/* {
		root * /srv/doc
		rewrite / "/test-badger Technical Documentation.dc.html"
		rewrite /deck "/test-badger Technical Deck.dc.html"
		file_server
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

{$SHOP_SITE} {
	encode zstd gzip
	reverse_proxy shop:8100
}
