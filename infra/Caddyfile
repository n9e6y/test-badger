# Sites come from .env:
#   local:  APP_SITE=http://localhost        SHOP_SITE=http://shop.localhost
#   server: APP_SITE=app.<ip>.sslip.io       SHOP_SITE=shop.<ip>.sslip.io   (automatic HTTPS)

{$APP_SITE} {
	encode zstd gzip

	handle /api/* {
		# flush_interval -1: never buffer, so SSE (/api/runs/*/events) streams live.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Submission pages (D30, D31, D38; noindex D32): static Claude Design exports from blog/ (gitignored; copied
	# to the server separately), mounted read-only at /srv/blog. Trailing slashes keep relative
	# asset paths working.
	# /doc/ = technical documentation; the old deck link goes to the documentation (D33)
	redir /doc /doc/ 308
	redir /doc/deck /doc/ 302
	handle_path /doc/* {
		root * /srv/blog/technical-doc
		# keep submission pages out of search engines
		header X-Robots-Tag "noindex, nofollow"
		# the page's "Business plan" link points at a sibling copy: send it to the real page
		@businessplan path "/test-badger Business Plan*"
		redir @businessplan /business-plan/ 302
		rewrite / "/test-badger Tech Docs.dc.html"
		file_server
	}

	# /business-plan/ = business plan (web), /business-plan/print = paged print version
	redir /business-plan /business-plan/ 308
	handle_path /business-plan/* {
		root * /srv/blog/business-plan
		# keep submission pages out of search engines
		header X-Robots-Tag "noindex, nofollow"
		rewrite / "/test-badger Business Plan Web v2.dc.html"
		rewrite /print "/test-badger Business Plan.dc.html"
		file_server
	}

	# /brand/ = brand page (D38); its sibling links go to the real pages
	redir /brand /brand/ 308
	handle_path /brand/* {
		root * /srv/blog/brand
		# keep submission pages out of search engines
		header X-Robots-Tag "noindex, nofollow"
		@brandbusinessplan path "/test-badger Business Plan*"
		redir @brandbusinessplan /business-plan/ 302
		@brandtechdocs path "/test-badger Tech Docs*"
		redir @brandtechdocs /doc/ 302
		rewrite / "/test-badger Brand.dc.html"
		file_server
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

# Redesigned app (frontend-v2) beside the current one, same API and accounts.
{$NEW_APP_SITE:new-app.localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/frontend-v2
		try_files {path} /index.html
		file_server
	}
}

{$SHOP_SITE} {
	encode zstd gzip
	reverse_proxy shop:8100
}
