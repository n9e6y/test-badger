# Copy to infra/.env and fill in. Never commit the real .env.
#   Generate secrets:
#     JWT_SECRET:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#     FERNET_KEY:  python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

ENVIRONMENT=prod

# --- Sites (Caddy) ---
# Local:  APP_SITE=http://localhost   SHOP_SITE=http://shop.localhost   SHOP_HOST=shop.localhost
# Server: APP_SITE=app.<ip>.sslip.io  SHOP_SITE=shop.<ip>.sslip.io     SHOP_HOST=shop.<ip>.sslip.io
APP_SITE=app.203-0-113-10.sslip.io
SHOP_SITE=shop.203-0-113-10.sslip.io
SHOP_HOST=shop.203-0-113-10.sslip.io

# --- Database / queue ---
POSTGRES_USER=shipcheck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shipcheck
DATABASE_URL=postgresql+asyncpg://shipcheck:change-me@postgres:5432/shipcheck
REDIS_URL=redis://redis:6379/0

# --- Auth / secrets ---
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true
FERNET_KEY=change-me
ARTIFACTS_DIR=/data/artifacts

# --- LLM: "<provider>:<model>", provider = anthropic | openai | openai_compat ---
# OpenRouter example: LLM_EXECUTOR=openai_compat:anthropic/claude-sonnet-5.5   (cheap: google/gemini-3.8-flash)
# Fallbacks: separate models with | and they are tried in order on rate limits / outages.
LLM_PLANNER=anthropic:claude-sonnet-5-5
LLM_EXECUTOR=anthropic:claude-sonnet-5-5
LLM_VERIFIER=anthropic:claude-sonnet-5-5
LLM_REPORTER=anthropic:claude-haiku-4-5
# Executor for Easy ("quick") runs, D17. Empty = Easy uses LLM_EXECUTOR too.
LLM_EXECUTOR_QUICK=openai_compat:google/gemini-3.8-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible resellers: OpenRouter, Gemini (https://generativelanguage.googleapis.com/v1beta/openai/), Groq...
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# JSON {"model-id": [usd_per_mtok_in, usd_per_mtok_out]} for models not in the built-in price table
LLM_PRICE_OVERRIDES={}

# --- Scenario video (D22): one WebM per browser context, shown in the report ---
VIDEO_ENABLED=true

# --- Budgets ---
RUN_COST_CAP_USD=1.00
MAX_CONCURRENT_RUNS=2
RUNS_PER_USER_PER_DAY=10

# --- Demo shop ---
# URL the worker's browser uses. Server: https://$SHOP_HOST (reached via Caddy alias). Local: http://shop:8100
DEMO_SHOP_URL=https://shop.203-0-113-10.sslip.io
# URL users see for the demo shop (same as DEMO_SHOP_URL on the server)
DEMO_SHOP_PUBLIC_URL=https://shop.203-0-113-10.sslip.io
SHOP_ADMIN_TOKEN=change-me
SHOP_SESSION_SECRET=change-me
# Empty = clean mode; unset = all bugs on
# BUGS_ENABLED=B1,B2,B3,B4,B5,B6,B7,B8,B9
